---
import BaseLayout from './BaseLayout.astro';
import AnnounceBar from '../components/AnnounceBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import ConfluenceBackdrop from '../components/ConfluenceBackdrop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Per-page JSON-LD nodes, forwarded to BaseLayout's site-wide @graph. */
  schema?: Record<string, unknown>[];
  /** RSS feed for this page (e.g. /blog/rss.xml), forwarded to BaseLayout. */
  rssHref?: string;
}
const { title, description, image, schema, rssHref } = Astro.props;
---
<BaseLayout title={title} description={description} image={image} schema={schema} rssHref={rssHref}>
  {/* THE MARKETING SURFACE'S OWN FIELD — two rivers meeting, not a neural net.
      Swapped 2026-08-24 with the palette. The network was built for a near-black
      ground where a faint glowing web reads as depth; on warm off-white it reads
      as a purple scrawl over paper, and it told every visitor "AI product" on a
      page whose headline is "I ran a restaurant".

      The dark instrument look is NOT gone — the demo islands still carry their
      own, because an industrial tool SHOULD look like an instrument. This is the
      split the redesign is built on: warm and human at the front door,
      instrument-dark where the enterprise proof lives. (That sentence was
      missing a word for months and read as a fragment; noting the fix so the
      next reader does not go hunting for what changed.) */}
  <ConfluenceBackdrop />
  <div class="page-host">
    <AnnounceBar />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </div>
  {/* Spacer so the fixed mobile tab bar never overlaps footer content. */}
  <div class="h-16 lg:hidden" aria-hidden="true"></div>
  <MobileTabBar />
</BaseLayout>
