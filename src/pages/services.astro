---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Button from '../components/Button.astro';
import ServiceLadder from '../components/ServiceLadder.astro';
import { builds, projectModel, pricingNotes, startingPrice, assessmentPrice, websitePrice, type BuildIcon } from '../data/services';
import { ladder } from '../data/services';

/* Derived, never typed — see the comment beside where it renders. */
const rungCount = ladder.flatMap((b) => b.rungs).length;
import { Wrench, Layers, Database, Plug, Sparkles, Check, ArrowUpRight } from '@lucide/astro';

const buildIcons: Record<BuildIcon, any> = {
  wrench: Wrench,
  layers: Layers,
  database: Database,
  plug: Plug,
  sparkles: Sparkles,
};

const origin = new URL(Astro.site!).origin;
const schema = [
  {
    '@type': 'Service',
    '@id': `${origin}/services/#service`,
    name: 'Custom software & AI tooling for small business',
    serviceType: 'Custom operational software development',
    provider: { '@id': `${origin}/#organization` },
    areaServed: 'US',
    description:
      'Custom software you own — a single tool, a connected suite, a full system, or integration into what you already run. Scales from a sole operator to an enterprise.',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'What I build',
      itemListElement: [
        'A single operational tool',
        'A connected tool suite',
        'A full custom system you own',
        'Integration & implementation into existing systems',
      ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${origin}/services/` },
    ],
  },
];
---
<MarketingLayout
  schema={schema}
  title="Services"
  description={`Custom software you own — one tool, a suite, a full system, or integration into what you already run. ${startingPrice.line} Starts with a free conversation and a fixed quote, and grows with your business.`}
  image="/og/services.png"
>
  {/* ── Hero — lead with the work, not the rate card ──────────────────────── */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="bg-grid bg-grid-fade pointer-events-none absolute inset-0 -z-10 opacity-60"></div>
    <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
      <p class="mono-label">Services</p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        What I build — and how we build it together.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Builds start at {startingPrice.amount} — that is a floor, not a quote. The first conversation is free,
        every engagement after it starts with a fixed number agreed before any work, and it ends
        with software that is yours outright. Most of this starts small: the first rung below is a
        solo operator.
      </p>
    </div>
  </section>

  {/* ── /01 What I build ──────────────────────────────────────────────────── */}
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="flex items-center gap-2.5">
      <span class="section-index">/ 01</span>
      <span class="mono-label">What I build</span>
    </p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      One tool, a suite, or the whole system.
    </h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
      A scope ladder, not a fixed menu — most engagements start small and specific, and grow only
      if the problem warrants it.
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {builds.map((b) => {
        const Icon = buildIcons[b.icon];
        return (
          <div class="panel lift spotlight flex flex-col gap-3 p-6">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-line bg-canvas text-accent-2">
              <Icon size={20} aria-hidden="true" />
            </span>
            <h3 class="font-display text-lg font-semibold text-ink">{b.title}</h3>
            <p class="text-sm leading-relaxed text-ink-muted">{b.body}</p>
          </div>
        );
      })}
    </div>
  </section>

  {/* ── /02 How we work together ──────────────────────────────────────────── */}
  <section class="section-band">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="flex items-center gap-2.5">
        <span class="section-index">/ 02</span>
        <span class="mono-label">How we work together</span>
      </p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Start with one build — or climb as you grow.
      </h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">
        A single defined project with no commitment, or an ongoing relationship that scales with
        you — from your first tool to a standing partnership.
      </p>

      {/* One-off: Project */}
      <div class="panel lift spotlight mt-10 p-7 sm:flex sm:items-start sm:justify-between sm:gap-10">
        <div class="max-w-md">
          <p class="mono-label text-cyan-deep">One-off</p>
          <h3 class="mt-2 font-display text-xl font-semibold text-ink sm:text-2xl">{projectModel.title}</h3>
          <p class="mt-1 text-sm text-ink-muted">{projectModel.tagline}</p>
        </div>
        <ul class="mt-5 flex flex-col gap-2.5 sm:mt-0 sm:max-w-sm">
          {projectModel.includes.map((item) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-muted">
              <Check size={16} class="mt-0.5 shrink-0 text-up" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Ongoing: the ladder. The count is DERIVED — it said "Six rungs" while
          rendering four, because rungs 5 and 6 were removed on 2026-08-24 and
          the prose was not. Same class as D22's tool count, applied to rungs. */}
      <p class="mono-label mt-12 text-cyan-deep">Ongoing — pick your altitude</p>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
        {rungCount} rungs, from your very first tool to a standing arrangement — climb only as far
        as the business needs.
      </p>
      <div class="mt-8 max-w-3xl">
        <ServiceLadder />
      </div>
    </div>
  </section>

  {/* ── /03 How pricing works (premium, quote-based, concrete) ────────────── */}
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <p class="flex items-center gap-2.5">
      <span class="section-index">/ 03</span>
      <span class="mono-label">How pricing works</span>
    </p>
    {/* THE NUMBER LEADS, and the qualifier sits immediately under it.
        Separating them by so much as a section is how a floor gets read as a
        quote — the single failure mode of publishing one number instead of a
        menu. Both strings come from services.ts so this page and any other
        surface quoting the figure cannot say two different things. */}
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {startingPrice.line}
    </h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-muted">
      {startingPrice.qualifier}
    </p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {pricingNotes.map((n) => (
        <div class="panel lift spotlight p-7">
          <h3 class="font-display text-lg font-semibold text-ink">{n.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-muted">{n.body}</p>
        </div>
      ))}
    </div>

    {/* Quiet small-business / website fold-in — deliberately understated. */}
    <div class="panel lift spotlight mt-4 border-accent/30 p-7">
      <p class="mono-label text-cyan-deep">Just getting online?</p>
      <p class="mt-2 max-w-3xl leading-relaxed text-ink-muted">
        Running your business off a Facebook page — or nothing at all? I’ll build you a real
        website you own, not a rented template or a profile on someone else’s platform. Same
        principle as everything else here: it’s yours, and you’re not paying rent on it forever.
        <span class="text-ink-faint"> (Ongoing upkeep is optional, on a retainer.)</span>
      </p>
      {/* THIS LINE BREAKS AN ANCHOR, and it is not decoration. The price headline sits two panels
          above this one, so a reader arrives here having just read the floor and joins the two
          without anybody claiming they go together. A website is the largest thing sold, not the
          smallest, and the floor was sized for a fitted shelf tool — docs/engagement/reference/
          rate-card.md, "the floor buys a fitting".

          IT NOW NAMES THE FIGURE, WHICH IT REFUSED TO DO UNTIL 2026-09-03. The sentence here used
          to read "a site is a bigger job ... so it carries its own number", which breaks the anchor
          and puts nothing in its place: a reader leaves knowing only that a website costs more than
          the build floor, and somebody comparing three quotes reads that as evasion. The website
          floor is published now, so the honest fix is the number and a door to the page arguing it. */}
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-muted">
        <span class="font-semibold text-ink">{websitePrice.line}</span> {websitePrice.qualifier}
      </p>
      <p class="mt-3">
        <a href="/websites/" class="link-sweep text-sm">
          What that buys, and why it beats renting one →
        </a>
      </p>
      <p class="mt-3">
        <a href="/main-street/" class="link-sweep text-sm">
          More on the local small-business focus →
        </a>
      </p>
    </div>

    {/* THE SECOND PUBLISHED NUMBER LIVES ON ITS OWN PAGE AND IS POINTED AT FROM
        HERE, because this is where a visitor reading about money already is.

        It is a SIBLING of the floor above, never a tier of it, and the copy has
        to keep saying so. The floor is where a build starts; this is the entire
        cost of a finished piece of work. Two products with one price each is not
        the menu the last pricing note above explains this practice does not
        publish — but writing "starts at" here would make it one. */}
    <div class="panel lift spotlight mt-4 p-7">
      <p class="mono-label text-cyan-deep">Not sure what to build yet?</p>
      <h3 class="mt-2 font-display text-lg font-semibold text-ink">{assessmentPrice.line}</h3>
      <p class="mt-2 max-w-3xl leading-relaxed text-ink-muted">
        For a business that wants to use AI and genuinely cannot see where it fits. I come out, watch
        how the work is actually done, and write you a list of what is worth building with a number
        beside each line. {assessmentPrice.qualifier}
      </p>
      <p class="mt-3">
        <a href="/ai-fit/" class="link-sweep text-sm">
          What the assessment covers →
        </a>
      </p>
    </div>
  </section>

  {/* ── Closing CTA → quote intent ────────────────────────────────────────── */}
  <section class="mx-auto max-w-4xl px-6 pb-20 text-center sm:pb-28">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      Tell me the problem. I’ll scope the fix.
    </h2>
    <p class="mx-auto mt-4 max-w-xl leading-relaxed text-ink-muted">
      Whichever shape it takes, it starts the same way: you describe the problem, I tell you
      straight how I’d build it — and what it’ll take.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <Button href="/contact/?intent=quote" variant="primary">Request a quote</Button>
      <Button href="/work/" variant="secondary">See the live tools</Button>
    </div>
  </section>
</MarketingLayout>
