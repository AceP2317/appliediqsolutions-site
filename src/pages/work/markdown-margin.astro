---
import DemoLayout from '../../layouts/DemoLayout.astro';
import DemoFraming from '../../components/DemoFraming.astro';
import { demos, demoSchema } from '../../data/demos';
import MarkdownMargin from '../../components/demos/markdown-margin.jsx';
import DemoAbout from '../../components/DemoAbout.astro';
import IslandSkeleton from '../../components/IslandSkeleton.astro';

const demo = demos.find((d) => d.slug === 'markdown-margin')!;
const schema = demoSchema(demo, new URL(Astro.site!).origin);
---
<DemoLayout title={demo.name} description={demo.seoDescription} image={`/og/${demo.slug}.png`} toolName={demo.name} schema={schema}>
  <DemoFraming name={demo.name} instrument={demo.instrument} tagline={demo.tagline} problem={demo.problem} does={demo.blurb} plain={demo.plain} />
  <MarkdownMargin client:only="react">
    <IslandSkeleton slot="fallback" name={demo.name} />
  </MarkdownMargin>
  <DemoAbout name={demo.name} about={demo.about} ask={demo.ask} />
</DemoLayout>
