---
/**
 * /admin — the PRIVATE content console. Paste-to-publish for the news desk;
 * fetch→AI-analyze→review→publish flow for the AI-news feed, so neither needs the
 * the /ai-news terminal skill is no longer the only way in. Posts to the Worker
 * (/api/admin/*), which validates → firewall-scans → commits the markdown to the
 * repo; the normal push→build→gate→deploy pipeline does the rest.
 *
 * Security: this route + /api/admin/* sit behind a Cloudflare Access application
 * (only the operator's email). The Worker also re-verifies the Access JWT
 * (fail-closed). noindex + sitemap-excluded belt-and-braces; the page holds no
 * secrets. The terminal skills remain the escape hatch if Access is ever down.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminConsole from '../components/AdminConsole.jsx';
---
<BaseLayout
  title="Admin console"
  description="Private content console for AppliedIQ Solutions."
  noindex
>
  <main class="mx-auto max-w-4xl px-6 py-10 sm:py-14">
    <header class="mb-8">
      <p class="mono-label">AppliedIQ · private</p>
      <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink">Content console</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
        Add a news story — no terminal. Everything you commit here
        runs the same build + firewall gate before it goes live (~1 min after you publish).
      </p>
    </header>
    <AdminConsole client:load />
  </main>
</BaseLayout>
