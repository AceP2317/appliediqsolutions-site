---
import Wordmark from './Wordmark.astro';
import SocialIcon from './SocialIcon.astro';
import { socialLinks, businessPhone, businessPhoneDisplay } from '../data/links';
import { buildInfo } from '../data/buildinfo';
const year = 2026;
// The serial plate — quiet proof this is a living system that ships
// continuously. Hash omitted gracefully if git was unavailable at build time.
const plate = [
  buildInfo.commit ? `BUILD ${buildInfo.commit}` : 'BUILD',
  buildInfo.builtAtLabel,
  'main → Cloudflare edge',
].join(' · ');
---
<footer class="mt-24 border-t border-line">
  {/* brain-clear: the bottom-center brain bleeds into the footer on every page. */}
  <div class="brain-clear mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-2">
      <Wordmark />
      {/* Renders on every page, so it states the OFFER, not the moat. The
          supply-chain depth is why the work is good; it is not what is sold. */}
      <p class="max-w-sm text-sm text-ink-faint">
        Custom software for small business — a real website you own, your spreadsheets turned into a live tool, and the one-off tools the big systems leave out. Built by an operator, owned by you.
      </p>
      <div class="flex gap-4">
        {socialLinks.map((s) => (
          <a
            href={s.href}
            aria-label={s.name}
            target="_blank"
            rel="noopener"
            class="text-ink-faint transition-colors hover:text-ink"
          >
            <SocialIcon path={s.iconPath} size={18} />
          </a>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-2 sm:items-end">
      <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-ink-muted sm:justify-end" aria-label="Footer">
        {/* THE THREE PAGES A LOCAL VISITOR IS ACTUALLY BEING SENT TO were all
            missing here until 2026-08-25: the lead offer (/check/), the selling
            page (/tools/), and the free deadline list — which had exactly one
            inbound link on the whole site. The footer renders on every
            marketing page, so an absence here is an absence everywhere. */}
        {/* "Tools you can buy", not "Tools", since 2026-09-09. This page had
            four labels across four surfaces — Tools here, "Finished tools" in
            the header and the mobile sheet, "All the tools" on every tool
            page. One page, one name. /work/ keeps the short "Work" below on
            purpose: it is also a bottom tab under an icon, where length is a
            hard constraint, and it sits next to nothing it can be confused
            with here. */}
        {/* THE THREE DOORS LEAD, SINCE 2026-09-20 (D118), then the local pages
            a visitor is sent to, then the proof, then the person. Every page
            the cut retires left this row the same day; the full menu carries
            each one until its own phase deletes it. */}
        <a href="/websites/" class="transition-colors hover:text-ink">Websites</a>
        <a href="/main-street/" class="transition-colors hover:text-ink">Main Street</a>
        <a href="/supply-chain/" class="transition-colors hover:text-ink">For manufacturers</a>
        <a href="/tools/" class="transition-colors hover:text-ink">Tools you can buy</a>
        <a href="/check/" class="transition-colors hover:text-ink">Free check</a>
        <a href="/deadlines/" class="transition-colors hover:text-ink">What is due</a>
        <a href="/work/" class="transition-colors hover:text-ink">Work</a>
        <a href="/confirmation-outlook/" class="transition-colors hover:text-ink">Confirmation Outlook</a>
        <a href="/bio/" class="transition-colors hover:text-ink">Bio</a>
        <a href="/contact/" class="transition-colors hover:text-ink">Contact</a>
      </nav>
      {/* THE LEGAL PAIR, added 2026-08-27. Kept OUT of the nav row above and put
          beside the copyright instead, which is where a reader looks for them and
          where they do not compete with the pages that sell anything.

          The privacy link is not decorative. California's online privacy law
          requires a commercial site collecting personal details from its
          residents to post a policy conspicuously, and it reaches operators
          outside California with no size threshold — the contact form puts this
          site squarely inside it. Several platforms (business SMS registration,
          some ad networks) also refuse an applicant whose site has no REACHABLE
          policy, so a page that exists but is linked from nowhere would not
          count. */}
      <p class="mono-label">
        <a href="/privacy/" class="transition-colors hover:text-ink">Privacy</a>
        <span class="mx-2 text-ink-faint/50">·</span>
        <a href="/terms/" class="transition-colors hover:text-ink">Terms</a>
      </p>
      {/* NAME, PLACE AND NUMBER, ADDED 2026-09-08. The number was on /card/ and
          nowhere else, and the two things a local search actually matches on —
          where the business is and how to ring it — appeared on one page each.
          A footer is where both belong, because it is the one block on every
          page. No street address: there is no premises, and the only address
          available is a home one, which is the operator's call to publish. */}
      <p class="mono-label">
        New Bern, NC
        <span class="mx-2 text-ink-faint/50">·</span>
        <a href={`tel:${businessPhone}`} class="transition-colors hover:text-ink">{businessPhoneDisplay}</a>
      </p>
      <p class="mono-label">© {year} AppliedIQ Solutions</p>
      {/* PLAIN TEXT SINCE 2026-09-20. The plate used to link to the ship log on
          /projects/, which D118 retires with that page; the plate itself is
          still the quiet proof that this is a living system that ships. */}
      <p class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-faint/70">{plate}</p>
    </div>
  </div>
</footer>
