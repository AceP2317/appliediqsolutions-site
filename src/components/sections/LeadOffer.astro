---
/**
 * LeadOffer — the Review Autopilot band, the practice's lead offer (D25/D29).
 *
 * Ported from the band that lived on /main-street/, which now runs a New Bern
 * framing of the same product. The two pages must not share a body verbatim —
 * that is the SEO cannibalization risk — but the autopilot rule is required on
 * every surface that describes this, so that one sentence is a deliberate
 * duplicate. Copy in home.ts; never call the drafting "trained".
 */
import Section from '../Section.astro';
import Button from '../Button.astro';
import { leadOffer } from '../../data/home';
---
<Section id="lead-offer">
  <p class="mono-label inline-flex items-center gap-2">
    <span class="status-dot"></span>
    {leadOffer.eyebrow}
  </p>
  <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
    {leadOffer.name}
  </h2>
  <p class="mt-3 text-xl leading-relaxed">
    <span class="aiq-accent">{leadOffer.tagline}</span>
  </p>
  <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-muted">
    {leadOffer.body}
  </p>

  <div class="mt-7 flex flex-wrap items-center gap-3">
    <Button href={leadOffer.cta.href} variant="primary">{leadOffer.cta.label}</Button>
    <a href="/contact/?intent=consult" class="link-sweep text-sm font-medium text-cyan-deep">
      The first conversation is free →
    </a>
  </div>

  <a href={leadOffer.cta.href} class="mt-10 block">
    <img
      src={leadOffer.shot}
      width="1200"
      height="630"
      loading="lazy"
      decoding="async"
      alt={leadOffer.shotAlt}
      class="w-full rounded-xl border border-line shadow-2xl shadow-black/40"
    />
  </a>

  <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
    {leadOffer.facts.map((f) => (
      <div class="flex flex-col gap-1">
        <dd class="font-display text-2xl font-semibold text-ink">{f.v}</dd>
        <dt class="mono-label text-ink-faint">{f.k}</dt>
      </div>
    ))}
  </dl>
</Section>
