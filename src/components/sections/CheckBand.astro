---
/**
 * CheckBand — the home page's door into the free check.
 *
 * WHY A BAND AND NOT THE TOOL ITSELF. The check is a React island, and mounting
 * it here would put a second interactive island on a page already measured at
 * over eight thousand pixels on a phone. It would also give the home page two
 * competing things to do above the fold. This is one line, one number, and one
 * button — the whole job of a door.
 *
 * WHY IT SITS ABOVE THE PROOF BAR. A visitor who has just read what a stranger's
 * career was is more likely to act on something they can DO than on further
 * reasons to believe him. The proof still comes; it comes second.
 */
import Section from '../Section.astro';
---
<Section tone="surface">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <p class="mono-label">Free · no signup · about a minute</p>
      <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        Start with a number, not a sales pitch.
      </h2>
      <p class="mt-3 leading-relaxed text-ink-muted">
        Two questions about how you order and chase stock, and you will know what the paperwork is
        costing you a year — with the arithmetic printed, so you can check it yourself. Nothing is
        sent anywhere, and there is no email box.
      </p>
    </div>
    <div class="shrink-0">
      <a href="/check/" class="btn btn-primary">Run the free check →</a>
    </div>
  </div>
</Section>
