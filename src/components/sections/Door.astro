---
/**
 * Door — one of the three bands the home page is made of since D118 (2026-09-20).
 *
 * THE HOME PAGE IS THREE DOORS AND NOTHING ELSE. A website anyone can own, Main
 * Street for a local business, and the factory tools for a manufacturer. Each
 * door is one band with the same bones — an eyebrow, a title, a body, one
 * button, and a list of what is behind the door — so that a reader compares
 * three offers rather than three designs. The shape pack the operator picked
 * from (arrangement 1, "doors stacked", 2026-09-20) drew exactly this: the same
 * component three times, on three grounds.
 *
 * THE GROUND IS THE ONLY THING THAT VARIES, AND IT VARIES ON PURPOSE. Section.astro
 * paints the surface, deep and instrument grounds; this component adds nothing
 * to the palette. `tone="instrument"` reads its values out of industrial.js the
 * way Breadth.astro does, so the manufacturers door is the same dark chassis
 * the seven factory demos run on — dark already means industrial here and light
 * already means yours (themes.js), and the cut is the argument.
 *
 * NO COUNT IS TYPED. `facts` arrive from the caller already derived: the scope
 * items from website-scope.js, the shelf count from demos.ts, the founding line
 * from founding.ts, the factory tool names from workGroups. A door that typed
 * "seven tools" would be wrong the day an eighth shipped (D22).
 *
 * THE FIGURE TRAVELS WITH ITS QUALIFIER. `panel` takes a line and a qualifier
 * together and renders them in one box, so no door can show a price without
 * what happens to it — the rule src/lib/pricing.js states for every published
 * figure, and the one verify-website.mjs measures within 400 characters.
 */
import Section from '../Section.astro';
import Button from '../Button.astro';
import { versioned } from '../../data/asset-version';
import { NORTHPOINT } from '../kit/industrial.js';

interface Props {
  id: string;
  tone?: 'canvas' | 'surface' | 'deep' | 'instrument';
  width?: 'content' | 'popout' | 'feature' | 'full';
  density?: 'tight' | 'regular' | 'tall';
  eyebrow: string;
  title: string;
  body: string;
  cta: { label: string; href: string };
  /** What is behind the door, one short line each. Derived by the caller. */
  facts?: string[];
  /** A figure and the sentence that qualifies it, rendered as one box. */
  panel?: { line: string; qualifier: string };
  /** A screenshot shown on phones only: the Opener carries it on desktop, so it
      renders exactly once at every width. */
  shot?: { src: string; alt: string; href: string };
}

const {
  id,
  tone = 'canvas',
  width = 'content',
  density = 'regular',
  eyebrow,
  title,
  body,
  cta,
  facts = [],
  panel,
  shot,
} = Astro.props;

/* THE COLORS ARE READ, NOT RETYPED — the same nine variables Breadth.astro sets,
   from the same cool chassis, so that check-contrast.mjs's measured pairs are the
   ones that render here. */
/* Northpoint's dark mode since 2026-09-24, when D42's faceplate was deleted:
   the nine values are the same ones, carried over unchanged. */
const ins = NORTHPOINT.modes.dark.bands.masterData;
const ink = NORTHPOINT.modes.dark.base;
const insVars = [
  `--ins-bg:${ins.bg}`,
  `--ins-surface:${ins.surface}`,
  `--ins-border:${ins.border}`,
  `--ins-border-strong:${ins.borderStrong}`,
  `--ins-text:${ink.text}`,
  `--ins-text-sec:${ink.textSec}`,
  `--ins-text-muted:${ink.textMuted}`,
  `--ins-accent:${ink.accentText}`,
  `--ins-info:${ink.info}`,
].join(';');

/* Two columns only where the column is wide enough to hold two. The popout
   width is a reading column, and a list beside it would be two cramped ones. */
const twoCol = facts.length > 0 && width !== 'popout';
---
<Section
  id={id}
  tone={tone}
  width={width}
  density={density}
  style={tone === 'instrument' ? insVars : undefined}
>
  <div class:list={['grid gap-8', twoCol && 'lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-14']}>
    <div>
      <p class="mono-label">{eyebrow}</p>
      <h2 class="mt-3 font-display text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
        {title}
      </h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-muted">{body}</p>
      {panel && (
        <div class="panel mt-6 max-w-xl p-5">
          <p class="font-display text-2xl font-semibold text-ink">{panel.line}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{panel.qualifier}</p>
        </div>
      )}
      <div class="mt-7">
        <Button href={cta.href} variant="primary">{cta.label}</Button>
      </div>
    </div>

    {/* THE DEEP DOOR CARRIES THE 3px RULE the free-check ledger introduced under
        D113 — the one heavy rule on the page, against hairlines everywhere else. */}
    {facts.length > 0 && (
      <ul
        class:list={[
          'grid gap-2',
          !twoCol && 'mt-2 sm:grid-cols-2',
          tone === 'deep' && 'border-t-[3px] border-ink pt-4',
        ]}
      >
        {facts.map((f) => (
          <li class="rounded-lg border border-line bg-surface/70 px-4 py-2.5 text-sm leading-relaxed text-ink-muted">
            {f}
          </li>
        ))}
      </ul>
    )}
  </div>

  {shot && (
    <a href={shot.href} class="mt-8 block lg:hidden">
      <img
        src={versioned(shot.src)}
        width="1200"
        height="630"
        loading="lazy"
        decoding="async"
        alt={shot.alt}
        class="w-full rounded-xl border border-line shadow-2xl shadow-black/30"
      />
    </a>
  )}
</Section>
