# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Claude Code local (machine-specific) settings — skills DO get committed
.claude/settings.local.json

# wrangler local secrets (Worker dev)
.dev.vars
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# mirror-publish staging (assembled sanitized tree — never commit)
.mirror/out/

# social / marketing upload assets (uploaded to the platform, not site assets)
/linkedin-*.png
/nextdoor-*.png
# The packed client files. Root-anchored ON PURPOSE: written without the leading
# slash this also matched src/handover/ at any depth, which happened to give the
# right outcome (those entries are regenerated every run) but for the wrong
# reason — a pattern semantic rather than a decision. Any future hand-written
# file in a directory named handover would have vanished silently.
/handover/

# The per-tool entry shells and mount files, GENERATED on every `npm run handover`
# by scripts/build-handover.mjs. Ignored deliberately and separately, so the line
# above can be about the packed output alone.
src/handover/

# Generated by `npm run pdfs` from docs/engagement and docs/playbooks.
# NOT committed on purpose: one source of wording, regenerated on demand, so a stale
# PDF can never be attached to an email while the markdown says something else.
docs/pdf/

# Operator note mirrored here by ~/.claude/note.py. Never committed: it carries
# working notes and client detail, and the OneDrive copy is the backup.
AppliedIQ Solutions.docx

# Operator note mirrored here by ~/.claude/note.py. Never committed: it carries
# working notes and client detail, and the OneDrive copy is the backup.
Appliediqsolutions.docx
